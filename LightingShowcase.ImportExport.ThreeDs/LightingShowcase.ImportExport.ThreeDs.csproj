<!-- MSBuild evaluates this file before compiling any C# in the project. Target-framework/compiler properties change how the source is interpreted; ProjectReference entries establish which sibling assemblies are available at compile time; PackageReference entries become restored external build inputs. This project compiles against LightingShowcase.Core. Keeping those dependency edges explicit is what prevents source files from silently relying on assemblies that the project does not declare. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LightingShowcase.Core/LightingShowcase.Core.csproj" />
  </ItemGroup>
</Project>
