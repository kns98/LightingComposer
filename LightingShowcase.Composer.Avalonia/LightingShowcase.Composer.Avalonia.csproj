<!-- MSBuild evaluates this file before compiling any C# in the project. Target-framework/compiler properties change how the source is interpreted; ProjectReference entries establish which sibling assemblies are available at compile time; PackageReference entries become restored external build inputs. This project compiles against LightingShowcase.Core, LightingShowcase.ImportExport.Obj, LightingShowcase.ImportExport.Stl, LightingShowcase.ImportExport.Ply, LightingShowcase.ImportExport.ThreeDs, LightingShowcase.ImportExport.Gltf, LightingShowcase.ImportExport.PropXml, LightingShowcase.ImportExport.Fbx, LightingShowcase.ObjectLibrary.BuiltIns, LightingShowcase.ObjectLibrary.ReadyMade. Its external dependencies include Avalonia.Desktop, Avalonia.Themes.Fluent, Avalonia.Wayland. Keeping those dependency edges explicit is what prevents source files from silently relying on assemblies that the project does not declare. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <AssemblyName>LightingShowcase.Composer</AssemblyName>
    <RootNamespace>LightingShowcase.Composer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../LightingShowcase.Core/LightingShowcase.Core.csproj" />
    <ProjectReference Include="../LightingShowcase.ImportExport.Obj/LightingShowcase.ImportExport.Obj.csproj" />
    <ProjectReference Include="../LightingShowcase.ImportExport.Stl/LightingShowcase.ImportExport.Stl.csproj" />
    <ProjectReference Include="../LightingShowcase.ImportExport.Ply/LightingShowcase.ImportExport.Ply.csproj" />
    <ProjectReference Include="../LightingShowcase.ImportExport.ThreeDs/LightingShowcase.ImportExport.ThreeDs.csproj" />
    <ProjectReference Include="../LightingShowcase.ImportExport.Gltf/LightingShowcase.ImportExport.Gltf.csproj" />
    <ProjectReference Include="../LightingShowcase.ImportExport.PropXml/LightingShowcase.ImportExport.PropXml.csproj" />
    <ProjectReference Include="../LightingShowcase.ImportExport.Fbx/LightingShowcase.ImportExport.Fbx.csproj" />
    <ProjectReference Include="../LightingShowcase.ObjectLibrary.BuiltIns/LightingShowcase.ObjectLibrary.BuiltIns.csproj" />
    <ProjectReference Include="../LightingShowcase.ObjectLibrary.ReadyMade/LightingShowcase.ObjectLibrary.ReadyMade.csproj" />
  </ItemGroup>



  <ItemGroup>
    <None Include="../Shaders/vulkan_scene_primary.comp"
          Link="Shaders/vulkan_scene_primary.comp"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
